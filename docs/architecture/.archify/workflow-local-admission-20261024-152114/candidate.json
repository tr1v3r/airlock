  "cards": [
    {
      "dot": "cyan",
      "title": "错误优先级",
      "items": [
        "nil context 会 panic；显式空租户、非法权重先于取消校验。",
        "ctx.Err 在锁内检查；取消与授予以锁内状态转换为准。"
      ]
    },
    {
      "dot": "cyan",
      "title": "TryAcquire 旁路",
      "items": [
        "TryAcquireN 校验后只检查容量及是否有人等待。",
        "不能立即授予就 ErrWouldBlock；不排队，但仍获取互斥锁。"
      ]
    },
    {
      "dot": "cyan",
      "title": "释放与完成",
      "items": [
        "授予赢得竞争时，即使 context 已取消也可能成功返回。",
        "库不执行任务；所有成功返回的 Permit 都需要释放。"
      ]
    }
  ]
