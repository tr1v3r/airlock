  "cards": [
    {
      "dot": "cyan",
      "title": "三种原子边界",
      "items": [
        "Memory 和 PostgreSQL 在独占资源后直接调用 Transition。",
        "Redis 按 Transition 返回的 CommitWindow 做 CAS；同时校验原快照与发布时间。"
      ]
    },
    {
      "dot": "cyan",
      "title": "自定义驱动的切入点",
      "items": [
        "实现 Driver 的五个方法；SharedState 是可选参考，存储布局自选。",
        "即使有业务错误，也要提交非 nil 新快照；传输错误是未知结果。",
        "Observe 在免维护期可只读应答，不推进 Revision。"
      ]
    },
    {
      "dot": "cyan",
      "title": "部署与性能边界",
      "items": [
        "Memory 仅供测试演示；远端驱动分别是独立 Go 模块。",
        "PostgreSQL 增量写变更行；免维护期 Observe 只读、Revision 不变。"
      ]
    }
  ]
