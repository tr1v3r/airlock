  "cards": [
    {
      "dot": "cyan",
      "title": "三种原子边界",
      "items": [
        "Memory 和 PostgreSQL 在独占资源后直接调用 Transition。",
        "Redis 通过 TransitionOptimistic 计算；CAS 同时校验原快照与发布时间。"
      ]
    },
    {
      "dot": "cyan",
      "title": "自定义驱动的切入点",
      "items": [
        "实现 Driver 的五个方法；不可自行修改 opaque snapshot。",
        "即使有业务错误，也要提交非 nil 新快照；传输错误是未知结果。"
      ]
    },
    {
      "dot": "cyan",
      "title": "部署与性能边界",
      "items": [
        "Memory 仅供测试演示；远端驱动分别是独立 Go 模块。",
        "每资源全快照读写；Observe 也推进状态，不能当作廉价只读查询。"
      ]
    }
  ]
